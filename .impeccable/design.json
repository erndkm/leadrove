  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary search or save action: forest with white text in light mode, neutral light gray with charcoal text in dark mode.",
      "html": "<button class=\"ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Search area</button>",
      "css": ".ds-primary{font-family:'Manrope','Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:7px;font-size:12px;font-weight:700;min-height:40px;padding:10px 16px;cursor:pointer;transition:background-color .16s,color .16s,box-shadow .16s;background:var(--accent,#204c46);color:#fff}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#153e38)}.ds-primary:disabled{cursor:wait;opacity:.55}.ds-primary:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}:host-context([data-theme='dark']) .ds-primary{color:#1a1a1a}:host-context([data-theme='dark']) .ds-primary:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting action on a white light-mode surface or raised charcoal dark-mode surface.",
      "html": "<button class=\"ds-secondary\">Explore businesses</button>",
      "css": ".ds-secondary{font-family:'Manrope','Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:7px;font-size:12px;font-weight:700;min-height:40px;padding:10px 16px;cursor:pointer;transition:background-color .16s,color .16s,box-shadow .16s;background:var(--raised,#fff);box-shadow:inset 0 0 0 1px var(--line,#e2e7e2);color:var(--ink,#253832)}.ds-secondary:hover:not(:disabled){background:#f4f6f2}.ds-secondary:disabled{cursor:wait;opacity:.55}.ds-secondary:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}:host-context([data-theme='dark']) .ds-secondary:hover:not(:disabled){background:#353535;color:var(--ink,#efefef)}:host-context([data-theme='dark']) .ds-secondary:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Location search",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Open labeled field with themed suggestion rows. Choosing a suggested location previews the draft area before the user starts a business search.",
      "html": "<label class=\"ds-search-label\" for=\"ds-location\">Search location</label><div class=\"ds-search-wrap\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg><input id=\"ds-location\" class=\"ds-search-input\" placeholder=\"Town, neighborhood or address\" /></div>",
      "css": ".ds-search-label{font-family:'Manrope','Segoe UI',sans-serif;display:block;font-size:11px;font-weight:700;color:#627167;margin-bottom:9px}.ds-search-wrap{display:flex;align-items:center;gap:9px;height:39px;color:#627167}.ds-search-input{font-family:'Manrope','Segoe UI',sans-serif;border:0;background:transparent;font-weight:650;font-size:13px;height:36px;color:var(--ink,#253832);padding:0 2px;min-width:0;width:100%;caret-color:var(--accent,#204c46)}.ds-search-input::placeholder{color:#757e79}.ds-search-input:focus-visible{outline:3px solid #689b81;outline-offset:3px}:host-context([data-theme='dark']) .ds-search-label,:host-context([data-theme='dark']) .ds-search-wrap{color:var(--muted,#b5b5b5)}:host-context([data-theme='dark']) .ds-search-input::placeholder{color:#b5b5b5}:host-context([data-theme='dark']) .ds-search-input:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Lead notes",
      "kind": "input",
      "refersTo": "notes-field",
      "description": "A visible label and bordered field for personal research notes.",
      "html": "<label class=\"ds-notes-label\" for=\"ds-notes\">Notes<span>Saved as you type</span></label><textarea class=\"ds-notes\" id=\"ds-notes\" rows=\"3\" placeholder=\"What stood out? What would you offer?\"></textarea>",
      "css": ".ds-notes-label{font-family:'Manrope','Segoe UI',sans-serif;display:flex;justify-content:space-between;font-size:10px;font-weight:700;margin:14px 0 8px;color:var(--ink,#253832)}.ds-notes-label span{font-size:8px;font-weight:500;color:#5f6e5d}.ds-notes{font-family:'Manrope','Segoe UI',sans-serif;width:100%;font-size:11px;border:1px solid var(--line,#e2e7e2);border-radius:6px;padding:9px;background:var(--surface,#fff);color:var(--ink,#253832);line-height:1.7;resize:vertical;min-height:74px;caret-color:var(--accent,#204c46)}.ds-notes::placeholder{color:#757e79}.ds-notes:focus-visible{outline:3px solid #689b81;outline-offset:3px}:host-context([data-theme='dark']) .ds-notes-label span{color:var(--muted,#b5b5b5)}:host-context([data-theme='dark']) .ds-notes::placeholder{color:#b5b5b5}:host-context([data-theme='dark']) .ds-notes:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Text navigation with an active accent underline: forest in light mode, neutral light gray in dark mode.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example main navigation\"><button class=\"ds-nav-button ds-active\" aria-current=\"page\">Discover</button><button class=\"ds-nav-button\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/></svg>Saved leads<span class=\"ds-nav-count\">4</span></button></nav>",
      "css": ".ds-nav{display:flex;height:72px;gap:28px}.ds-nav-button{font-family:'Manrope','Segoe UI',sans-serif;display:flex;align-items:center;gap:8px;border:0;background:transparent;position:relative;color:#6b746e;font-size:13px;font-weight:700;padding:0 2px;cursor:pointer;transition:color .16s}.ds-nav-button.ds-active,.ds-nav-button:hover{color:var(--accent,#204c46)}.ds-nav-button.ds-active:after{content:'';height:3px;position:absolute;bottom:0;left:0;right:0;background:var(--accent,#204c46);border-radius:3px 3px 0 0}.ds-nav-count{font-size:11px;padding:1px 6px;border-radius:5px;background:#edf0ec;min-width:20px;text-align:center}.ds-nav-button:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav-button{transition:none}}:host-context([data-theme='dark']) .ds-nav-button{color:var(--muted,#b5b5b5)}:host-context([data-theme='dark']) .ds-nav-button.ds-active,:host-context([data-theme='dark']) .ds-nav-button:hover{color:var(--accent,#e0e0e0)}:host-context([data-theme='dark']) .ds-nav-count{background:var(--quiet-surface,#252525);color:#cccccc}:host-context([data-theme='dark']) .ds-nav-button:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Checkbox filter chip",
      "kind": "chip",
      "description": "A selected filter with a real checkbox and a visible focus boundary.",
      "html": "<label class=\"ds-chip\"><input type=\"checkbox\" checked /><span class=\"ds-check\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span>No website listed</label>",
      "css": ".ds-chip{font-family:'Manrope','Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:5px;cursor:pointer;color:#64726a;font-size:11px;font-weight:600;position:relative;white-space:nowrap;min-height:28px}.ds-chip:hover{background:#f4f6f2}.ds-chip:has(input:checked){background:#eef3ec;color:#385844}.ds-chip input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer;margin:0}.ds-chip:focus-within{outline:2px solid #689b81;outline-offset:2px}.ds-check{display:flex;align-items:center;justify-content:center;border:1px solid #aab5a9;border-radius:3px;width:13px;height:13px}.ds-check svg{visibility:hidden}.ds-chip input:checked+.ds-check{background:#607f55;color:#fff;border-color:#607f55}.ds-chip input:checked+.ds-check svg{visibility:visible}:host-context([data-theme='dark']) .ds-chip{color:var(--muted,#b5b5b5)}:host-context([data-theme='dark']) .ds-chip:hover{background:#353535;color:var(--ink,#efefef)}:host-context([data-theme='dark']) .ds-chip:has(input:checked){background:var(--accent-soft,#333333);color:#e2e2e2}:host-context([data-theme='dark']) .ds-chip:focus-within{outline-color:#c8d9e6}:host-context([data-theme='dark']) .ds-check{border-color:#999999}:host-context([data-theme='dark']) .ds-chip input:checked+.ds-check{background:#e0e0e0;color:#1a1a1a;border-color:#e0e0e0}"
    },
    {
      "name": "Priority score",
      "kind": "custom",
      "refersTo": "score-high",
      "description": "Tabular priority numbers on light or dark semantic score surfaces; high 70–100, medium 45–69, low 0–44.",
      "html": "<div class=\"ds-scores\"><span class=\"ds-score ds-high\" aria-label=\"High priority 85 out of 100\">85</span><span class=\"ds-score ds-medium\" aria-label=\"Medium priority 60 out of 100\">60</span><span class=\"ds-score ds-low\" aria-label=\"Low priority 30 out of 100\">30</span></div>",
      "css": ".ds-scores{display:flex;gap:10px}.ds-score{font-family:'Manrope','Segoe UI',sans-serif;font-size:11px;font-weight:750;line-height:22px;min-width:28px;padding:0 5px;text-align:center;border-radius:5px;font-variant-numeric:tabular-nums}.ds-high{background:#e8f0e0;color:#4e6d37}.ds-medium{background:#f7efde;color:#946720}.ds-low{background:#edf0ed;color:#68746a}:host-context([data-theme='dark']) .ds-high{background:#324632;color:#c1ddab}:host-context([data-theme='dark']) .ds-medium{background:#463b27;color:#ead09e}:host-context([data-theme='dark']) .ds-low{background:#363636;color:#d2d2d2}"
    },
    {
      "name": "Search area preview",
      "kind": "card",
      "refersTo": "map-location",
      "description": "The cyan or teal circle stays geographically anchored while the map viewport moves. Search this area explicitly stages a proposal at the viewport center; Scan this circle? offers Confirm search and Cancel without changing results. Panning preserves the proposal; Move preview here explicitly restages it. Cancel or Escape restores the prior area and radius. Radius updates remain live; fitting leaves the circle clear below controls and switches/scrolls mobile Map.",
      "html": "<div class=\"ds-map-location\"><span class=\"ds-location-icon\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 2v5m0 10v5M2 12h5m10 0h5\"/></svg></span><div><strong>Scan this circle?</strong><span class=\"ds-location-caption\">2 km radius · 4 km across · approx. 12.6 km²</span><span class=\"ds-preview-note\">Preview only. Your results have not changed.</span><div class=\"ds-area-confirmation\" role=\"group\" aria-label=\"Confirm new search area\"><button class=\"ds-confirm-search\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Confirm search</button><button class=\"ds-cancel-proposal\">Cancel</button></div></div></div>",
      "css": ".ds-map-location{font-family:'Manrope','Segoe UI',sans-serif;background:var(--raised,#fff);box-shadow:0 3px 14px #2e483215;display:inline-flex;align-items:center;gap:10px;border-radius:8px;padding:11px 13px;color:var(--ink,#253832)}.ds-location-icon{display:grid;place-items:center;background:#e6f1f4;color:var(--scan,#176c81);width:31px;height:31px;border-radius:7px;flex-shrink:0}.ds-map-location strong{font-size:11px;display:block;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:330px}.ds-location-caption{font-size:10px;color:#5a6c55;display:block;margin-top:3px}.ds-preview-note{display:block;font-size:9px;line-height:1.4;color:#5a6c55;margin-top:3px}:host-context([data-theme='dark']) .ds-location-icon{background:#30383b;color:var(--scan,#8ac9da)}:host-context([data-theme='dark']) .ds-location-caption,:host-context([data-theme='dark']) .ds-preview-note{color:var(--muted,#b5b5b5)}.ds-confirm-search{font-family:'Manrope','Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:7px;font-size:12px;font-weight:700;min-height:40px;padding:10px 16px;cursor:pointer;transition:background-color .16s,color .16s,box-shadow .16s;background:var(--accent,#204c46);color:#fff}.ds-confirm-search:hover:not(:disabled){background:var(--accent-hover,#153e38)}.ds-confirm-search:disabled{cursor:wait;opacity:.55}.ds-confirm-search:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-confirm-search{transition:none}}:host-context([data-theme='dark']) .ds-confirm-search{color:#1a1a1a}:host-context([data-theme='dark']) .ds-confirm-search:focus-visible{outline-color:#c8d9e6}.ds-map-location{align-items:flex-start}.ds-location-icon{margin-top:2px}.ds-area-confirmation{display:flex;align-items:center;gap:15px;margin-top:11px}.ds-confirm-search{min-height:34px;padding:7px 10px;font-size:11px}.ds-cancel-proposal{font-family:'Manrope','Segoe UI',sans-serif;border:0;background:transparent;color:var(--accent,#204c46);font-size:11px;font-weight:650;min-height:34px;cursor:pointer}.ds-cancel-proposal:hover{text-decoration:underline}.ds-cancel-proposal:focus-visible{outline:3px solid #689b81;outline-offset:3px}:host-context([data-theme='dark']) .ds-cancel-proposal:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Ranked business row",
      "kind": "custom",
      "refersTo": "business-row-selected",
      "description": "Flat selection row, with identity above category and website evidence.",
      "html": "<article class=\"ds-business-row\"><button class=\"ds-business-select\" aria-label=\"View example business, priority 85\"><span class=\"ds-rank\">01</span><span class=\"ds-summary\"><span class=\"ds-title\"><strong>Example business</strong><span class=\"ds-row-score\">85</span></span><span class=\"ds-meta\">Local service · 450 m</span><span class=\"ds-address\">Street address</span><span class=\"ds-website\">No website listed</span></span></button><button class=\"ds-save\" aria-label=\"Save example business\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/></svg></button></article>",
      "css": ".ds-business-row{position:relative;border-bottom:1px solid #eaf0e8;background:var(--surface,#fff);transition:background-color .16s;width:370px;max-width:100%}.ds-business-row:hover{background:#f8faf6}.ds-business-row:has(.ds-business-select[aria-pressed=true]){background:#eef4eb}.ds-business-select{font-family:'Manrope','Segoe UI',sans-serif;display:flex;gap:11px;width:100%;text-align:left;border:0;background:transparent;padding:17px 20px 17px 18px;min-height:132px;color:var(--ink,#253832);cursor:pointer}.ds-rank{font-size:11px;line-height:21px;color:#5f705b;min-width:18px;font-variant-numeric:tabular-nums}.ds-summary{min-width:0;flex:1}.ds-title{display:flex;align-items:flex-start;gap:10px}.ds-title strong{font-size:13px;line-height:20px;font-weight:750;letter-spacing:-.1px;flex:1;overflow-wrap:anywhere}.ds-row-score{font-size:11px;font-weight:750;line-height:22px;min-width:28px;padding:0 5px;text-align:center;border-radius:5px;font-variant-numeric:tabular-nums;background:#e8f0e0;color:#4e6d37}.ds-meta,.ds-address{display:block;font-size:11px;color:#5f6e5d;line-height:16px;margin-top:3px}.ds-address{margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:12px}.ds-website{display:inline-flex;font-size:10px;line-height:20px;border-radius:4px;padding:0 6px;margin-top:10px;background:#f1f2ea;color:#6a7150}.ds-save{position:absolute;bottom:17px;right:20px;display:grid;place-items:center;width:25px;height:25px;background:transparent;border:0;color:#64775b;border-radius:4px;cursor:pointer}.ds-save:hover{background:#e8efdf;color:#668254}.ds-business-select:focus-visible{outline:3px solid #689b81;outline-offset:3px}.ds-save:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-business-row{transition:none}}:host-context([data-theme='dark']) .ds-business-row{border-color:var(--line,#3b3b3b)}:host-context([data-theme='dark']) .ds-business-row:hover{background:#353535}:host-context([data-theme='dark']) .ds-business-row:has(.ds-business-select[aria-pressed=true]){background:var(--accent-soft,#333333)}:host-context([data-theme='dark']) .ds-rank,:host-context([data-theme='dark']) .ds-meta,:host-context([data-theme='dark']) .ds-address{color:var(--muted,#b5b5b5)}:host-context([data-theme='dark']) .ds-business-row:has(.ds-business-select[aria-pressed=true]) .ds-rank{color:var(--accent,#e0e0e0)}:host-context([data-theme='dark']) .ds-row-score{background:#324632;color:#c1ddab}:host-context([data-theme='dark']) .ds-website{background:#333333;color:#cecece}:host-context([data-theme='dark']) .ds-save{color:#bbbbbb}:host-context([data-theme='dark']) .ds-save:hover{background:var(--accent-soft,#333333);color:#e2e2e2}:host-context([data-theme='dark']) .ds-business-select:focus-visible,:host-context([data-theme='dark']) .ds-save:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Numbered map pin",
      "kind": "custom",
      "refersTo": "map-pin-high",
      "description": "Circular rank marker with a larger outlined selection state; pale borders remain visible over the themed map.",
      "html": "<div class=\"ds-pins\"><button class=\"ds-pin\" aria-label=\"Business 1, priority 85\" aria-pressed=\"false\">1</button><button class=\"ds-pin ds-selected\" aria-label=\"Business 2, priority 80\" aria-pressed=\"true\">2</button></div>",
      "css": ".ds-pins{display:flex;align-items:center;gap:20px;padding:10px;background:#e7ecdf}.ds-pin{font-family:'Manrope','Segoe UI',sans-serif;display:flex;align-items:center;justify-content:center;border:2px solid #fff;width:32px;height:32px;border-radius:50%;background:#476a4e;color:#fff;box-shadow:0 2px 5px #17392838;font-size:11px;font-weight:750;cursor:pointer;transition:background-color .16s,color .16s,box-shadow .16s}.ds-pin.ds-selected{background:#183e35;outline:4px solid #ffffffa8;width:38px;height:38px;margin:-3px;font-size:13px;box-shadow:0 3px 8px #17392850}.ds-pin:hover{background:#244a3a;scale:1.08}.ds-pin:focus-visible{outline:3px solid #689b81;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-pin{transition:none}}:host-context([data-theme='dark']) .ds-pins{background:#202020}:host-context([data-theme='dark']) .ds-pin{border-color:#dddddd}:host-context([data-theme='dark']) .ds-pin.ds-selected{outline-color:#e0e0e0;background:#222222}:host-context([data-theme='dark']) .ds-pin:focus-visible{outline-color:#c8d9e6}"
    },
    {
      "name": "Theme toggle",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "Sun or moon control names the destination mode. An explicit choice persists under cf:theme; before first render, a valid saved choice takes precedence over the system color preference. Desktop 34px square; mobile 30px by 34px.",
      "html": "<button class=\"ds-theme-toggle ds-to-dark\" aria-label=\"Switch to dark mode\" title=\"Switch to dark mode\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z\"/></svg></button><button class=\"ds-theme-toggle ds-to-light\" aria-label=\"Switch to light mode\" title=\"Switch to light mode\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41\"/></svg></button>",
      "css": ".ds-theme-toggle{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:6px;background:var(--accent-soft,#edf3ed);color:var(--accent,#204c46);cursor:pointer;transition:background-color .16s,color .16s,box-shadow .16s}.ds-theme-toggle:hover{background:var(--accent-soft,#edf3ed)}.ds-theme-toggle:focus-visible{outline:3px solid #689b81;outline-offset:3px}:host-context([data-theme='dark']) .ds-theme-toggle:hover{background:#353535;color:var(--ink,#efefef)}:host-context([data-theme='dark']) .ds-theme-toggle:focus-visible{outline-color:#c8d9e6}@media(max-width:680px){.ds-theme-toggle{width:30px}}@media(prefers-reduced-motion:reduce){.ds-theme-toggle{transition:none}}.ds-to-light{display:none}:host-context([data-theme='dark']) .ds-to-dark{display:none}:host-context([data-theme='dark']) .ds-to-light{display:grid}"
    }
  ],
  "narrative": {
    "northStar": "The Municipal Research Workbench",
    "overview": "ClientFinder borrows the orderly character of municipal mapping software and reduces it to one person's daily research workspace. Light mode places white work surfaces on a cool gray canvas; dark mode uses neutral charcoal surfaces, pale ink and near-white actions. Green and ochre retain their research-priority roles, while a separate teal or cyan boundary identifies the search area.\n\nThe built identity is compact and deliberate: Manrope carries both labels and headings, thin dividers separate evidence, and tabular numerals connect ranked rows to circular map pins. Flat work areas make room for lifted controls and the focused business inspector. The source is the final cascade in `web/src/styles.css` and `web/src/appearance.css`, with behavior in `web/src/App.jsx` and `web/src/BusinessMap.jsx` and initial theme selection in `web/index.html`.",
    "keyCharacteristics": [
      "Compact, readable rows with explicit names, categories and evidence.",
      "Forest actions in light mode and neutral light-gray actions on charcoal in dark mode.",
      "A teal or cyan search-area boundary distinct from research priority.",
      "Corresponding rank numbers in the list and on the map.",
      "Soft corners and thin rules, with depth reserved for overlays.",
      "Explicit mobile views and a focused detail sheet."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Pair priority color with a number and a written explanation; color alone never states the business's opportunity.",
        "section": "colors"
      },
      {
        "name": "The Identity First Rule",
        "body": "Present the business name before its category and address; keep the score separate from the name so it can be compared vertically.",
        "section": "typography"
      },
      {
        "name": "The Work Surface Rule",
        "body": "Keep working rows flat; use elevation when a control or detail surface sits over other content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the correspondence between row rank, map number and selected business.",
      "Do retain visible labels, keyboard focus and contrasted secondary text.",
      "Do use flat rows, thin dividers and restrained selection surfaces: green in light mode, neutral charcoal in dark mode.",
      "Do keep source limitations adjacent to priority evidence.",
      "Do reserve normal layout space for the mobile List/Map control.",
      "Do use the corresponding semantic palette for light and dark work surfaces, text, actions and focus.",
      "Do keep the draft search boundary and its measurements distinct from the last completed results.",
      "Do show radius changes immediately and preserve map scale unless expansion needs more room.",
      "Do keep the circle geographically anchored during map exploration and require explicit confirmation of a proposed map area."
    ],
    "donts": [
      "Don't present research priority as a probability or verified website audit.",
      "Don't rely on color alone to communicate score or state.",
      "Don't replace the shared workspace with nested decorative cards.",
      "Don't let mobile navigation obscure the working content.",
      "Don't promote the sidecar's synthesized tonal ramps into shipped tokens without implementation evidence.",
      "Don't imply that moving or resizing the preview has refreshed the business results.",
      "Don't make the circle follow map movement or scan a proposed map area before confirmation."
    ]
  }
}
