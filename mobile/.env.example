# Optional public Overpass endpoint for business searches.
# Defaults: https://overpass-api.de/api/interpreter, then
# https://maps.mail.ru/osm/tools/overpass/api/interpreter on transient failure.
# A custom endpoint replaces both defaults: searches never fall back to a public
# provider when one is configured. HTTPS is required, without URL credentials.
# Use a provider with capacity for your deployment before distributing the app.
# EXPO_PUBLIC_OVERPASS_URL=https://your-provider.example/api/interpreter

# EXPO_PUBLIC values are bundled into the app. Never put secrets here.
