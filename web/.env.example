# Optional provider overrides. Use only public, non-secret configuration here.
# Leave unset to use the built-in primary and backup map servers.
# A custom primary uses only its explicitly configured fallbacks (comma-separated).
# VITE_OVERPASS_URL=https://your-overpass-server.example/api/interpreter
# VITE_OVERPASS_FALLBACK_URLS=https://your-backup-server.example/api/interpreter
VITE_GEOCODER_URL=https://photon.komoot.io/api/
# The default vector basemap is OpenFreeMap (no API key required).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional raster tile override. If set, it takes precedence over VITE_MAP_STYLE_URL.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
